input {
  beats {
    port => 5044
  }
}

filter {
  if [log_type] == "nginx" {
    grok {
      match => {
        "message" => "%{IPORHOST:nginx.remote_addr} - %{DATA:nginx.remote_user} \[%{HTTPDATE:nginx.time_local}\] \"%{WORD:nginx.method} %{DATA:nginx.request} HTTP/%{NUMBER:nginx.http_version}\" %{NUMBER:nginx.status:int} %{NUMBER:nginx.body_bytes_sent:int} \"%{DATA:nginx.http_referer}\" \"%{DATA:nginx.http_user_agent}\""
      }
      tag_on_failure => ["_grokparsefailure_nginx"]
    }
    mutate {
      add_field => { "event.dataset" => "nginx.access" }
    }
    date {
      match => ["[nginx][time_local]", "dd/MMM/yyyy:H:m:s Z"]
      target => "@timestamp"
    }
  } else if [log_type] == "php_fpm" {
    grok {
      match => {
        "message" => '%{IPORHOST:php_fpm.remote_addr} - +%{DATA:php_fpm.time_local} "%{WORD:php_fpm.method} %{GREEDYDATA:php_fpm.request}" %{NUMBER:php_fpm.status:int} %{NUMBER:php_fpm.request_time:float} %{NUMBER:php_fpm.memory:int} %{NUMBER:php_fpm.cpu:float}%%'
      }
      tag_on_failure => ["_grokparsefailure_php_fpm"]
      overwrite => ["message"]
    }
    mutate {
      add_field => { "event.dataset" => "php-fpm.access" }
    }
  }  else if [log_type] == "postgresql" {
    grok {
      match => {
        "message" => [
          "%{TIMESTAMP_ISO8601:postgresql.log_time} \[%{NUMBER:postgresql.pid:int}\] %{LOGLEVEL:postgresql.level}: %{GREEDYDATA:postgresql.message}",
          "%{TIMESTAMP_ISO8601:postgresql.log_time} %{DATA:postgresql.tz} \[%{NUMBER:postgresql.pid:int}\] %{LOGLEVEL:postgresql.level}: %{GREEDYDATA:postgresql.message}"
        ]
      }
      tag_on_failure => ["_grokparsefailure_postgresql"]
    }
    mutate {
      add_field => { "event.dataset" => "postgresql.log" }
    }
    date {
      match => ["[postgresql][log_time]", "ISO8601"]
      target => "@timestamp"
    }
  }
}

output {
  elasticsearch {
    hosts => ["http://elasticsearch:9200"]
    user => "elastic"
    password => "${ELASTIC_PASSWORD}"
    ilm_enabled => true
    ilm_rollover_alias => "logs-app"
    ilm_pattern => "000001"
    ilm_policy => "logs-app-policy"
  }

  stdout {
    codec => rubydebug
  }
}
